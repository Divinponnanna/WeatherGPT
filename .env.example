# WeatherGPT - Environment Variables Template
# ---------------------------------------------
# 1. Copy this file to .env
# 2. Replace the placeholders below with your actual API keys
# 3. Never commit .env to version control or public repositories

# Google Gemini API Key (Required for conversational AI and RAG synthesis)
# Obtain a free key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Groq API Key (reserved for alternate LLM providers)
GROQ_API_KEY=your_groq_api_key_here
